# 复制本文件后必须生成敏感值；不要提交实际的 .env 文件。
# 推荐执行：.\scripts\generate-dev-env.ps1
AURUM_ENVIRONMENT=development
AURUM_DEBUG=false
AURUM_API_V1_PREFIX=/api/v1
AURUM_SERVER_HOST=127.0.0.1
AURUM_SERVER_PORT=8010
AURUM_DIRECT_SERVER_PORT=8011
POSTGRES_PASSWORD=
AURUM_APP_DB_PASSWORD=
AURUM_DATABASE_URL=
AURUM_MIGRATION_DATABASE_URL=
AURUM_APP_DATABASE_ROLE=aurum_app
AURUM_LANGGRAPH_AES_KEY=replace-with-a-random-32-byte-key
AURUM_REDIS_URL=redis://localhost:6379/0
# Shared DashScope key for chat generation and long-term-memory embedding.
AURUM_DASHSCOPE_API_KEY=
AURUM_CHAT_MODEL=qwen-plus
AURUM_CHAT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AURUM_CHAT_MODEL_TIMEOUT_SECONDS=60
AURUM_CHAT_MODEL_MAX_TOKENS=2048
AURUM_CHAT_MODEL_TEMPERATURE=0.1
AURUM_CHAT_MODEL_MAX_RETRIES=2
AURUM_CAPABILITY_AGENT_MAX_STEPS=3
AURUM_CAPABILITY_AGENT_MAX_TOOL_CALLS=6
AURUM_CAPABILITY_AGENT_HISTORY_MESSAGES=8
# 高成本入口默认 fail-closed；生产环境应按容量压测结果调整。
AURUM_QUOTA_CHAT_USER_REQUESTS_PER_MINUTE=10
AURUM_QUOTA_CHAT_GLOBAL_REQUESTS_PER_MINUTE=100
AURUM_QUOTA_GLOBAL_MODEL_REQUESTS_PER_MINUTE=200
AURUM_QUOTA_USER_DAILY_MODEL_TOKENS=200000
AURUM_QUOTA_GLOBAL_DAILY_MODEL_TOKENS=2000000
AURUM_QUOTA_USER_AGENT_CONCURRENCY=2
AURUM_QUOTA_GLOBAL_AGENT_CONCURRENCY=20
AURUM_QUOTA_MODEL_TOKENS_RESERVED_PER_REQUEST=8192
AURUM_QUOTA_AGENT_LEASE_SECONDS=900
AURUM_FINANCE_MARKET_STALE_AFTER_HOURS=72
AURUM_FINANCE_EXCHANGE_RATE_STALE_AFTER_HOURS=24
AURUM_FINANCE_TIMEZONE=Asia/Shanghai
AURUM_EMBEDDING_MODEL=text-embedding-v4
AURUM_EMBEDDING_DIMENSIONS=1024
AURUM_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
AURUM_EMBEDDING_BATCH_SIZE=16
AURUM_MEMORY_ENABLED=true
AURUM_MEMORY_ROLLOUT_PERCENTAGE=100
AURUM_MEMORY_MAX_ITEMS_PER_USER=200
AURUM_MEMORY_MAX_ITEMS_PER_COMMAND=5
AURUM_MEMORY_RETRIEVAL_LIMIT=5
AURUM_MEMORY_RETRIEVAL_MIN_SCORE=0.45
AURUM_MEMORY_CONTEXT_MAX_CHARACTERS=4000
AURUM_MEMORY_ITEM_MAX_CHARACTERS=800
AURUM_MEMORY_EMBEDDING_ENABLED=true
AURUM_MEMORY_DECISION_ENABLED=true
AURUM_MEMORY_DECISION_TIMEOUT_SECONDS=20
AURUM_MEMORY_DECISION_MAX_RETRIES=1
AURUM_MEMORY_CONFIRMATION_TTL_SECONDS=600
AURUM_JWT_SECRET_KEY=
AURUM_JWT_ALGORITHM=HS256
AURUM_JWT_ISSUER=aurum-agent
AURUM_JWT_AUDIENCE=aurum-web
AURUM_ACCESS_TOKEN_TTL_MINUTES=60
AURUM_REFRESH_TOKEN_TTL_DAYS=30
AURUM_REFRESH_TOKEN_COOKIE_NAME=aurum_refresh_token
AURUM_REFRESH_TOKEN_COOKIE_SECURE=false
AURUM_REFRESH_TOKEN_COOKIE_SAMESITE=lax
AURUM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AURUM_LOGIN_MAX_FAILURES=5
AURUM_LOGIN_FAILURE_WINDOW_SECONDS=900
AURUM_LOGIN_IP_REQUEST_LIMIT=30
AURUM_LOGIN_GLOBAL_REQUEST_LIMIT=300
AURUM_LOGIN_REQUEST_WINDOW_SECONDS=60
AURUM_LOG_LEVEL=INFO
# Prometheus is enabled by default; production gateways must keep /metrics private.
AURUM_METRICS_ENABLED=true
# Trace export is opt-in so local development never depends on a collector.
AURUM_OTEL_TRACING_ENABLED=false
AURUM_OTEL_SERVICE_NAME=aurum-agent
AURUM_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AURUM_OTEL_EXPORT_TIMEOUT_SECONDS=5
# Required only by the optional Grafana service in compose.observability.yaml.
GRAFANA_ADMIN_PASSWORD=
# P6.4 backup encryption uses a dedicated random 32-byte key encoded as base64.
# Keep real values in an external secret system; only stable identifiers belong in evidence.
AURUM_BACKUP_ENCRYPTION_KEY=
AURUM_BACKUP_KEY_ID=backup-key-local-v1
AURUM_LANGGRAPH_KEY_ID=checkpoint-key-local-v1
AURUM_JWT_KEY_ID=jwt-key-local-v1
# Optional off-host/independent-volume replica directory.
AURUM_BACKUP_REPLICA_DIRECTORY=
