# 复制本文件后必须生成敏感值；不要提交实际的 .env 文件。
# 推荐执行：.\scripts\generate-dev-env.ps1
AURUM_ENVIRONMENT=development
AURUM_DEBUG=false
AURUM_API_V1_PREFIX=/api/v1
AURUM_SERVER_HOST=127.0.0.1
AURUM_SERVER_PORT=8010
AURUM_DIRECT_SERVER_PORT=8011
POSTGRES_PASSWORD=
AURUM_APP_DB_PASSWORD=
AURUM_DATABASE_URL=
AURUM_MIGRATION_DATABASE_URL=
AURUM_APP_DATABASE_ROLE=aurum_app
AURUM_LANGGRAPH_AES_KEY=replace-with-a-random-32-byte-key
AURUM_REDIS_URL=redis://localhost:6379/0
# Shared DashScope key for chat generation and text embedding.
AURUM_DASHSCOPE_API_KEY=
AURUM_CHAT_MODEL=qwen-plus
AURUM_CHAT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AURUM_CHAT_MODEL_TIMEOUT_SECONDS=60
AURUM_CHAT_MODEL_MAX_TOKENS=2048
AURUM_CHAT_MODEL_TEMPERATURE=0.1
AURUM_CHAT_MODEL_MAX_RETRIES=2
AURUM_RAG_RETRIEVAL_LIMIT=6
AURUM_RAG_HYBRID_CANDIDATE_MULTIPLIER=4
AURUM_RAG_RRF_K=60
AURUM_RAG_RERANKER_ENABLED=true
AURUM_RERANKER_MODEL=qwen3-rerank
AURUM_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
AURUM_RERANKER_TIMEOUT_SECONDS=30
AURUM_RERANKER_MAX_RETRIES=1
AURUM_RAG_CONTEXT_MAX_CHARACTERS=24000
AURUM_RAG_CONTEXT_SOURCE_MAX_CHARACTERS=6000
AURUM_FINANCE_MARKET_STALE_AFTER_HOURS=72
AURUM_FINANCE_EXCHANGE_RATE_STALE_AFTER_HOURS=24
AURUM_FINANCE_TIMEZONE=Asia/Shanghai
AURUM_EMBEDDING_MODEL=text-embedding-v4
AURUM_EMBEDDING_DIMENSIONS=1024
AURUM_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
AURUM_EMBEDDING_BATCH_SIZE=16
# S3-compatible storage settings. Use MinIO credentials locally; do not commit real values.
AURUM_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
AURUM_OBJECT_STORAGE_BUCKET=aurum-knowledge
AURUM_OBJECT_STORAGE_REGION=us-east-1
# Application S3 credentials. Locally minio-init provisions this non-root identity and its bucket-only policy.
AURUM_OBJECT_STORAGE_ACCESS_KEY=
AURUM_OBJECT_STORAGE_SECRET_KEY=
# Initialization-only MinIO root credentials. Never provide these to API or worker containers.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AURUM_OBJECT_STORAGE_SECURE=false
# Browser-visible endpoint used only to sign download URLs; never use Docker-internal DNS here.
AURUM_OBJECT_STORAGE_EXTERNAL_ENDPOINT=http://127.0.0.1:9000
AURUM_OBJECT_STORAGE_READINESS_TIMEOUT_SECONDS=5
AURUM_OBJECT_STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
AURUM_INGESTION_QUEUE_NAME=aurum-ingestion
AURUM_INGESTION_TASK_TIMEOUT_SECONDS=900
AURUM_INGESTION_LEASE_SECONDS=960
AURUM_INGESTION_MAX_RETRIES=3
AURUM_INGESTION_MANUAL_RETRY_LIMIT=5
AURUM_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
AURUM_WORKER_HEARTBEAT_TTL_SECONDS=45
AURUM_OUTBOX_DISPATCH_INTERVAL_SECONDS=10
AURUM_OUTBOX_BACKOFF_BASE_SECONDS=5
AURUM_OUTBOX_BACKOFF_MAX_SECONDS=300
AURUM_DOCUMENT_MAX_SIZE_BYTES=52428800
AURUM_DOCUMENT_MAX_PDF_PAGES=500
AURUM_DOCUMENT_MAX_TABULAR_ROWS=100000
AURUM_DOCUMENT_MAX_TABULAR_COLUMNS=256
AURUM_DOCUMENT_MAX_WORKBOOK_SHEETS=128
AURUM_DOCUMENT_MAX_CELL_CHARACTERS=32767
AURUM_DOCUMENT_MAX_EXTRACTED_CHARACTERS=10000000
AURUM_DOCUMENT_MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
AURUM_DOCUMENT_MAX_ARCHIVE_COMPRESSION_RATIO=100
AURUM_CHUNK_MAX_TOKENS=800
AURUM_CHUNK_OVERLAP_TOKENS=100
AURUM_DOCUMENT_MAX_CHUNKS=10000
AURUM_JWT_SECRET_KEY=
AURUM_JWT_ALGORITHM=HS256
AURUM_JWT_ISSUER=aurum-agent
AURUM_JWT_AUDIENCE=aurum-web
AURUM_ACCESS_TOKEN_TTL_MINUTES=15
AURUM_REFRESH_TOKEN_TTL_DAYS=30
AURUM_REFRESH_TOKEN_COOKIE_NAME=aurum_refresh_token
AURUM_REFRESH_TOKEN_COOKIE_SECURE=false
AURUM_REFRESH_TOKEN_COOKIE_SAMESITE=lax
AURUM_ADMIN_USERNAME=admin
AURUM_ADMIN_INITIAL_PASSWORD=
AURUM_ADMIN_EMAIL=admin@aurum.example.com
AURUM_BOOTSTRAP_ADMIN=true
AURUM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AURUM_LOGIN_MAX_FAILURES=5
AURUM_LOGIN_FAILURE_WINDOW_SECONDS=900
AURUM_LOGIN_IP_REQUEST_LIMIT=30
AURUM_LOGIN_GLOBAL_REQUEST_LIMIT=300
AURUM_LOGIN_REQUEST_WINDOW_SECONDS=60
AURUM_LOG_LEVEL=INFO
