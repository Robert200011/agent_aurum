{
  "version": "finance-load-single-node-v2",
  "name": "single-node-release",
  "base_url": "${AURUM_LOAD_BASE_URL}",
  "baseline_file": "baselines/single-node-release-v1.json",
  "metrics_path": "/metrics",
  "request_timeout_seconds": 45,
  "thresholds": {
    "maximum_server_error_rate": 0.01,
    "maximum_network_errors": 0,
    "maximum_cross_user_leak_count": 0,
    "maximum_p95_regression_ratio": 1.2
  },
  "observed_metric_prefixes": [
    "aurum_api_requests_total",
    "aurum_model_requests_total",
    "aurum_sse_connections",
    "aurum_database_pool_connections"
  ],
  "maximum_resource_growth": {
    "aurum_sse_connections": 0,
    "aurum_database_pool_connections{state=\"checked_out\"}": 2
  },
  "scenarios": [
    {
      "id": "ordinary-conversation-list",
      "kind": "ordinary_api",
      "method": "GET",
      "path": "/api/v1/conversations",
      "headers": {"Authorization": "Bearer ${AURUM_LOAD_ACCESS_TOKEN}"},
      "requests": 20,
      "concurrency": 2,
      "expected_statuses": [200]
    },
    {
      "id": "real-model-finance-smoke",
      "kind": "real_model",
      "method": "POST",
      "path": "/api/v1/conversations/${AURUM_LOAD_CONVERSATION_ID}/messages",
      "headers": {"Authorization": "Bearer ${AURUM_LOAD_ACCESS_TOKEN}"},
      "json": {"question": "概括我本月的收入、支出和净现金流。"},
      "requests": 4,
      "concurrency": 1,
      "expected_statuses": [200],
      "forbidden_response_markers": ["${AURUM_LOAD_OTHER_USER_MARKER}"]
    },
    {
      "id": "sse-stream",
      "kind": "sse",
      "method": "POST",
      "path": "/api/v1/conversations/${AURUM_LOAD_CONVERSATION_ID}/messages/stream",
      "headers": {"Authorization": "Bearer ${AURUM_LOAD_ACCESS_TOKEN}"},
      "json": {"question": "分析我本月的预算执行情况。"},
      "requests": 8,
      "concurrency": 2,
      "expected_statuses": [200],
      "forbidden_response_markers": ["${AURUM_LOAD_OTHER_USER_MARKER}"]
    }
  ]
}
