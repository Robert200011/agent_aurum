# Copy outside Git or inject these values from the deployment secret system.
AURUM_DEPLOY_ENVIRONMENT=production
AURUM_PUBLIC_DOMAIN=finance.example.com
AURUM_PUBLIC_ORIGIN=https://finance.example.com
AURUM_OBJECT_STORAGE_PUBLIC_DOMAIN=objects.finance.example.com
AURUM_GATEWAY_HEALTH_HOST=finance.example.com
AURUM_GATEWAY_HTTP_PORT=80
AURUM_GATEWAY_HTTPS_PORT=443

# Images must use an immutable Git SHA tag or digest; latest is rejected by release tooling.
AURUM_BLUE_API_IMAGE=registry.example.com/aurum-agent-api:0000000000000000000000000000000000000000
AURUM_GREEN_API_IMAGE=registry.example.com/aurum-agent-api:0000000000000000000000000000000000000000
AURUM_BLUE_WEB_IMAGE=registry.example.com/aurum-agent-web:0000000000000000000000000000000000000000
AURUM_GREEN_WEB_IMAGE=registry.example.com/aurum-agent-web:0000000000000000000000000000000000000000
AURUM_ACTIVE_API_IMAGE=registry.example.com/aurum-agent-api:0000000000000000000000000000000000000000
AURUM_MIGRATION_IMAGE=registry.example.com/aurum-agent-api:0000000000000000000000000000000000000000

# Production requires an HTTPS internal S3 endpoint or TLS-enabled MinIO.
AURUM_OBJECT_STORAGE_INTERNAL_ENDPOINT=https://minio:9000
AURUM_OBJECT_STORAGE_EXTERNAL_ENDPOINT=https://objects.finance.example.com
AURUM_OBJECT_STORAGE_SECURE=true
AURUM_MINIO_CERTS_DIR=/srv/aurum/secrets/minio-certs
AURUM_MINIO_CA_FILE=/srv/aurum/secrets/minio-certs/public.crt
AURUM_ACCESS_TOKEN_TTL_MINUTES=60
AURUM_REFRESH_TOKEN_TTL_DAYS=30
AURUM_REFRESH_TOKEN_COOKIE_SECURE=true
AURUM_RELEASE_STATE_DIR=/srv/aurum/release-state
AURUM_BACKUP_PRIMARY_DIR=/srv/aurum/backups/primary
AURUM_BACKUP_REPLICA_DIRECTORY=/mnt/aurum-offsite

# Required secrets. Values intentionally omitted.
POSTGRES_PASSWORD=
AURUM_APP_DB_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AURUM_OBJECT_STORAGE_ACCESS_KEY=
AURUM_OBJECT_STORAGE_SECRET_KEY=
AURUM_JWT_SECRET_KEY=
AURUM_LANGGRAPH_AES_KEY=
AURUM_DASHSCOPE_API_KEY=
AURUM_AGENT_MODEL_PLANNER_ENABLED=true
AURUM_BACKUP_ENCRYPTION_KEY=
AURUM_BACKUP_KEY_ID=
GRAFANA_ADMIN_PASSWORD=
